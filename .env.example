# Bird Buddy Credentials (REQUIRED)
USERNAME="your_email@example.com"
PASSWORD="your_password"

# Main Downloader Configuration
DOWNLOAD_DIR="./downloads"
DB_PATH="./data/birdbuddy_downloader.db"
INTERVAL=0             # Seconds between sync cycles (0 = single run mode, >0 = continuous daemon mode)
BUFFER_HOURS=2.0       # Hours before latest download timestamp to check feed
DB_RETENTION_DAYS=14   # Days to keep records in SQLite DB (0 to disable)
MAX_PAGES=0            # Max feed pages to fetch per sync (0 = unlimited)

# Media & Feeder Filtering
NO_IMAGES=false        # Set to true to skip image downloads (.jpg)
NO_VIDEOS=false        # Set to true to skip video downloads (.mp4)
FEEDER_FILTER=""       # Filter by feeder name (case-insensitive substring)
FULL_SYNC=false        # Force full sync ignoring timestamp cutoffs

# Custom Output Directory & Filename Templates
DIR_TEMPLATE="{feeder_name}/{species_name}"
FILENAME_TEMPLATE="{year}{month}{day}_{hour}{minute}{second}_{media_id_short}.{ext}"

# Modes & Debugging
DRY_RUN=false          # Set to true to preview downloads without downloading
VERBOSE=false          # Set to true for debug logging
